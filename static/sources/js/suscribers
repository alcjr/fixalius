(function (global, $) {
  'use strict';
  var FT = global.FixaliusTable, P = global.FIXALIUS_PAGE, U = P.urls;
  var _ = FT._, u = FT.util;

  var missing = Object.keys(P.expected || {}).filter(function (k) { return !U[k]; });
  if (missing.length) { /* … mismo bloque que clients.js … */ return; }

  FT.create({
    key: 'id',
    urls: { list: U.list, kpis: U.kpis },
    chipParam: 'chip',
    printTitle: _('Suscriptores'),
    exportName: 'Suscriptores',
    exportSheet: _('Suscriptores'),
    rowTitle: function (d) { return d.email; },
    deleteWarning: _('Se eliminará el suscriptor y su token de confirmación de forma permanente.'),

    kpis: [
      { id: 'total',        field: 'total' },
      { id: 'active',       field: 'active' },
      { id: 'pending',      field: 'pending' },
      { id: 'unsubscribed', field: 'unsubscribed' }
    ],

    columns: [
      {
        dataField: 'email', caption: _('Correo'), minWidth: 320,
        sortOrder: 'asc', sortIndex: 0,
        cellTemplate: function (cont, o) {
          var d = o.data;
          $('<div class="tp-cell tp-media">').append(
            $('<div class="tp-thumb">').css('background', u.avatarColor(d.email)).text(u.initials(d.email)),
            $('<div style="min-width:0">').append(
              $('<div class="tp-primary">').text(d.email || ('#' + d.id)),
              $('<div class="tp-secondary">').text('#' + d.id)
            )
          ).appendTo(cont);
        }
      },
      {
        dataField: 'activo', caption: _('Estado'), width: 150, alignment: 'center',
        cellTemplate: function (cont, o) {
          var d = o.data, n = d.baja ? 'danger' : (d.activo ? 'success' : 'warning');
          var txt = d.baja ? _('Baja') : (d.activo ? _('Activo') : _('Pendiente'));
          $('<div class="tp-cell tp-cell--center">')
            .append($('<span class="tp-badge tp-badge--' + n + '">').text(txt))
            .appendTo(cont);
        }
      },
      {
        dataField: 'alta', caption: _('Alta'), dataType: 'datetime', width: 180,
        cellTemplate: function (cont, o) {
          $('<div class="tp-cell">').text(u.fmtDate ? u.fmtDate(o.value, true) : (o.value || '—')).appendTo(cont);
        }
      },
      {
        dataField: 'baja', caption: _('Baja'), dataType: 'datetime', width: 180,
        cellTemplate: function (cont, o) {
          $('<div class="tp-cell">').toggleClass('tp-muted', !o.value)
            .text(o.value ? (u.fmtDate ? u.fmtDate(o.value, true) : o.value) : '—').appendTo(cont);
        }
      },
      {
        dataField: 'token_confirmacion', caption: _('Token'), width: 220, allowSorting: false,
        cellTemplate: function (cont, o) {
          var v = o.value || '';
          $('<div class="tp-cell tp-ellipsis">').append(
            v ? $('<span class="tp-tag">').text(v.slice(0, 8) + '…').attr('title', v)
              : $('<span class="tp-muted">').text('—')
          ).appendTo(cont);
        }
      }
    ],

    detail: { /* clon de clients.js cambiando campos */ },
    form:   { /* clon reducido: solo email + activo (checkbox) */ },
    exportColumns: [
      { header: _('ID'),     width: 8,  value: function (r) { return r.id; } },
      { header: _('Correo'), width: 42, value: function (r) { return r.email; } },
      { header: _('Estado'), width: 14, value: function (r) {
          return r.baja ? _('Baja') : (r.activo ? _('Activo') : _('Pendiente'));
        } },
      { header: _('Alta'),   width: 20, value: function (r) { return r.alta; } },
      { header: _('Baja'),   width: 20, value: function (r) { return r.baja; } }
    ]
  });
})(window, jQuery);