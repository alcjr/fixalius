#: .\templates\core\index.html
msgid "Análisis"
msgstr "Analysis"

#: .\templates\core\index.html
msgid "Entendemos el problema antes de proponer nada: procesos, datos y dónde la IA aporta valor real."
msgstr "We understand the problem before proposing anything: processes, data and where AI adds real value."

#: .\templates\core\index.html
msgid "Diseño"
msgstr "Design"

#: .\templates\core\index.html
msgid "Diseñamos la solución y su experiencia de uso, integrando IA donde ayuda, no como decoración."
msgstr "We design the solution and its user experience, integrating AI where it helps, not as decoration."

#: .\templates\core\index.html
msgid "Desarrollo"
msgstr "Development"

#: .\templates\core\index.html
msgid "Construimos, probamos y desplegamos aplicaciones mantenibles, seguras y medibles."
msgstr "We build, test and deploy applications that are maintainable, secure and measurable."

