msgid "La buena tecnología no solo es inteligente. Es comprensible, responsable y está hecha para durar."
msgstr "Good technology is not only smart. It is understandable, responsible and built to last."

#: .\templates\core\index.html
msgid "Datos del cliente"
msgstr "Client data"

#: .\templates\core\index.html
msgid "Los datos pertenecen al cliente. Cada solución se diseña conforme al RGPD."
