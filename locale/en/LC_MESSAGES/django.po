# =========================================================
# templates/core/index.html — qué hacemos
# =========================================================
#: .\templates\core\index.html
msgid "Qué hacemos"
msgstr "What we do"

#: .\templates\core\index.html
msgid "La IA no es el destino."
msgstr "AI is not the destination."

#: .\templates\core\index.html
msgid "Es la pieza que encaja."
msgstr "It's the piece that fits."

#: .\templates\core\index.html
msgid "Convertimos retos complejos en productos digitales claros, útiles y responsables. Desde la primera pregunta hasta el último despliegue, hacemos que la tecnología parezca estar en su sitio."
